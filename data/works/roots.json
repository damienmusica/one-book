[
  {
    "id": "gustave-flaubert--madame-bovary",
    "authorId": "gustave-flaubert",
    "titleKo": "마담 보바리",
    "titleOriginal": "Madame Bovary",
    "year": 1857,
    "genre": "fiction",
    "significance": "지방 의사의 아내가 소설에서 읽은 삶을 실제로 실행하려다 파산하는 과정을, 작가의 논평 없이 자유간접화법만으로 서술한다. 1856년 잡지 연재 직후 풍기문란으로 기소되었고 1857년 무죄 판결과 함께 단행본이 나오면서, 서술 방식 자체가 공적 쟁점이 된 사건이기도 하다.",
    "sourceIds": ["src--britannica", "src--pleiade"]
  },
  {
    "id": "gustave-flaubert--salammbo",
