[
  {
    "id": "rainer-maria-rilke--das-stunden-buch",
    "authorId": "rainer-maria-rilke",
    "titleKo": "기도시집",
    "titleOriginal": "Das Stunden-Buch",
    "year": 1905,
    "genre": "poetry",
    "significance": "수도사의 기도라는 형식을 빌려 신을 완성된 존재가 아니라 만들어지는 중인 대상으로 부르는 연작. 릴케의 이름을 독일어권에 처음 알린 시집이다.",
    "sourceIds": ["src--britannica", "src--poetry-foundation"]
  },
  {
    "id": "rainer-maria-rilke--neue-gedichte",
    "authorId": "rainer-maria-rilke",
    "titleKo": "신시집",
    "titleOriginal": "Neue Gedichte",
    "year": 1907,
    "genre": "poetry",
    "significance": "표범과 장미, 고대의 조각 같은 대상을 하나씩 응시해 시로 세우는 사물시의 방법이 한 권 규모로 실현된 시집. 로댕의 작업 방식을 시의 절차로 옮긴 결과다.",
    "sourceIds": ["src--britannica", "src--poetry-foundation"]
  },
  {
    "id": "rainer-maria-rilke--die-aufzeichnungen-des-malte-laurids-brigge",
    "authorId": "rainer-maria-rilke",
    "titleKo": "말테의 수기",
    "titleOriginal": "Die Aufzeichnungen des Malte Laurids Brigge",
    "year": 1910,
    "genre": "fiction",
    "significance": "줄거리 대신 짧은 기록의 연쇄로 파리의 가난과 죽음, 유년의 기억을 배열한 산문. 근대 도시 체험을 소설의 형식 문제로 옮긴 초기 사례다.",
    "sourceIds": ["src--britannica", "src--kr-world-lit-editions"]
  },
  {
    "id": "rainer-maria-rilke--duineser-elegien",
    "authorId": "rainer-maria-rilke",
    "titleKo": "두이노의 비가",
    "titleOriginal": "Duineser Elegien",
    "year": 1923,
    "genre": "poetry",
    "significance": "1912년 두이노 성에서 시작해 1922년 뮈조에서 열 편으로 완성한 장시 연작. 애도와 찬양을 하나의 어법으로 묶는 후기 릴케의 문법이 여기서 확립된다.",
    "sourceIds": ["src--britannica", "src--poetry-foundation", "src--kr-world-lit-editions"]
  },
  {
    "id": "rainer-maria-rilke--die-sonette-an-orpheus",
    "authorId": "rainer-maria-rilke",
    "titleKo": "오르페우스에게 바치는 소네트",
    "titleOriginal": "Die Sonette an Orpheus",
    "year": 1923,
    "genre": "poetry",
    "significance": "1922년 2월 며칠 사이에 쓴 55편의 소네트 연작. 정형시의 엄격한 틀 안에서 노래와 죽음, 변모를 다루며 『두이노의 비가』와 같은 시기에 완성되었다.",
    "sourceIds": ["src--britannica", "src--poetry-foundation"]
  },
  {
    "id": "rainer-maria-rilke--briefe-an-einen-jungen-dichter",
    "authorId": "rainer-maria-rilke",
    "titleKo": "젊은 시인에게 보내는 편지",
    "titleOriginal": "Briefe an einen jungen Dichter",
    "year": 1929,
    "genre": "essay-criticism",
    "significance": "1903–1908년 사관생도 프란츠 크사버 카푸스에게 보낸 열 통의 편지. 릴케 사후 카푸스가 엮어 1929년에 출간된 사후 간행물이며, 시를 쓰는 태도에 관한 그의 산문 중 가장 널리 읽힌다.",
    "sourceIds": ["src--britannica", "src--kr-world-lit-editions"]
  },
  {
    "id": "ts-eliot--the-love-song-of-j-alfred-prufrock",
    "authorId": "ts-eliot",
    "titleKo": "J. 앨프리드 프루프록의 연가",
    "titleOriginal": "The Love Song of J. Alfred Prufrock",
    "year": 1915,
    "genre": "poetry",
    "significance": "머뭇거리는 중년 화자의 내적 독백을 도시의 저녁 풍경과 겹쳐 놓은 시. 1915년 시카고의 잡지 《Poetry》에 실리며 영어 시의 어법이 바뀌는 지점을 표시했다.",
    "sourceIds": ["src--poetry-foundation", "src--britannica"]
  },
  {
    "id": "ts-eliot--the-sacred-wood",
    "authorId": "ts-eliot",
    "titleKo": "성스러운 숲",
    "titleOriginal": "The Sacred Wood: Essays on Poetry and Criticism",
    "year": 1920,
    "genre": "essay-criticism",
    "significance": "「전통과 개인의 재능」을 포함한 첫 평론집. 시를 시인의 개성 표현이 아니라 전통의 재배치로 설명하는 관점을 제시해 영미 비평의 방향을 바꾸었다.",
    "sourceIds": ["src--britannica", "src--poetry-foundation"]
  },
  {
    "id": "ts-eliot--the-waste-land",
    "authorId": "ts-eliot",
    "titleKo": "황무지",
    "titleOriginal": "The Waste Land",
    "year": 1922,
    "genre": "poetry",
    "significance": "전후 유럽의 정신적 고갈을 다섯 부분의 화자 전환과 여러 언어의 인용으로 조립한 장시. 에즈라 파운드의 편집으로 크게 축약되어 지금의 형태가 되었다.",
    "sourceIds": ["src--britannica", "src--poetry-foundation", "src--kr-world-lit-editions"]
  },
  {
    "id": "ts-eliot--murder-in-the-cathedral",
    "authorId": "ts-eliot",
    "titleKo": "대성당의 살인",
    "titleOriginal": "Murder in the Cathedral",
    "year": 1935,
    "genre": "drama",
    "significance": "토머스 베켓의 순교를 다룬 운문극으로 1935년 캔터베리 축제에서 초연되었다. 그리스 비극의 합창을 영어 종교극에 되살려 엘리엇의 후기 극작을 열었다.",
    "sourceIds": ["src--britannica", "src--kr-world-lit-editions"]
  },
  {
    "id": "ts-eliot--four-quartets",
    "authorId": "ts-eliot",
    "titleKo": "네 개의 사중주",
    "titleOriginal": "Four Quartets",
    "year": 1943,
    "genre": "poetry",
    "significance": "1936–1942년에 따로 발표된 네 편의 장시를 1943년에 한 권으로 묶은 연작. 시간과 기억, 신앙의 문제를 음악의 악장 구조에 맞춰 배열했다.",
    "sourceIds": ["src--britannica", "src--poetry-foundation"]
  },
  {
    "id": "gertrude-stein--three-lives",
    "authorId": "gertrude-stein",
    "titleKo": "세 인생",
    "titleOriginal": "Three Lives",
    "year": 1909,
    "genre": "fiction",
    "significance": "세 여성의 삶을 각각 다룬 중편 셋. 특히 「멜랑크타」에서 반복되는 구문으로 인물의 의식을 서술하는 방법이 처음 시도되었다.",
    "sourceIds": ["src--library-of-america", "src--britannica"]
  },
  {
    "id": "gertrude-stein--tender-buttons",
    "authorId": "gertrude-stein",
    "titleKo": "텐더 버튼스",
