[
  {
    "id": "jorge-luis-borges--fervor-de-buenos-aires",
    "authorId": "jorge-luis-borges",
    "titleKo": "부에노스아이레스의 열기",
    "titleOriginal": "Fervor de Buenos Aires",
    "year": 1923,
    "genre": "poetry",
    "significance": "자비로 낸 첫 시집. 변두리 골목과 저녁의 도시를 소재로 삼아, 이후 평생의 무대가 될 부에노스아이레스를 시의 지형으로 먼저 그려두었다.",
    "sourceIds": ["src--britannica", "src--cervantes-virtual"]
  },
  {
    "id": "jorge-luis-borges--historia-universal-de-la-infamia",
    "authorId": "jorge-luis-borges",
    "titleKo": "불한당들의 세계사",
    "titleOriginal": "Historia universal de la infamia",
    "year": 1935,
    "genre": "fiction",
    "significance": "실존한 사기꾼과 해적의 전기를 백과사전 항목처럼 고쳐 쓴 첫 산문집. 남의 이야기를 요약하고 비틀어 자기 서사를 만드는 보르헤스의 우회로가 여기서 시작된다.",
    "sourceIds": ["src--britannica", "src--kr-world-lit-editions"]
  },
  {
    "id": "jorge-luis-borges--ficciones",
    "authorId": "jorge-luis-borges",
    "titleKo": "픽션들",
    "titleOriginal": "Ficciones",
    "year": 1944,
    "genre": "fiction",
    "speculative": true,
    "significance": "「바벨의 도서관」과 「피에르 메나르, 『돈키호테』의 저자」가 함께 묶인 대표 단편집. 존재하지 않는 책에 대한 서평이라는 형식으로 소설이 필요로 하는 분량 개념 자체를 바꿨다.",
    "sourceIds": ["src--britannica", "src--kr-world-lit-editions"]
  },
  {
    "id": "jorge-luis-borges--el-aleph",
    "authorId": "jorge-luis-borges",
    "titleKo": "알레프",
    "titleOriginal": "El Aleph",
    "year": 1949,
    "genre": "fiction",
    "speculative": true,
    "significance": "우주의 모든 지점이 한자리에 겹쳐 보이는 구슬을 지하실에서 목격하는 표제작을 비롯해, 무한과 기억과 배신을 다룬 단편이 모였다. 보르헤스의 형이상학적 단편이 가장 밀도 높게 묶인 책이다.",
    "sourceIds": ["src--britannica", "src--kr-world-lit-editions"]
  },
  {
    "id": "jorge-luis-borges--otras-inquisiciones",
    "authorId": "jorge-luis-borges",
    "titleKo": "또 다른 심문들",
    "titleOriginal": "Otras inquisiciones",
    "year": 1952,
    "genre": "essay-criticism",
    "significance": "「카프카와 그의 선구자들」, 「존 윌킨스의 분석적 언어」처럼 짧은 에세이를 모은 산문집. 그의 글에서 소설과 에세이의 구분이 왜 무의미해지는지 가장 잘 보여준다.",
    "sourceIds": ["src--britannica", "src--cervantes-virtual"]
  },
  {
    "id": "jorge-luis-borges--el-libro-de-arena",
    "authorId": "jorge-luis-borges",
    "titleKo": "모래의 책",
    "titleOriginal": "El libro de arena",
    "year": 1975,
    "genre": "fiction",
    "speculative": true,
    "significance": "페이지가 무한히 늘어나 시작도 끝도 찾을 수 없는 책을 다룬 표제작이 실린 노년의 단편집. 초기의 장치를 더 건조한 문장으로 다시 시험한 결과물이다.",
    "sourceIds": ["src--britannica", "src--kr-world-lit-editions"]
  },
  {
    "id": "pablo-neruda--veinte-poemas-de-amor-y-una-cancion-desesperada",
    "authorId": "pablo-neruda",
    "titleKo": "스무 편의 사랑의 시와 한 편의 절망의 노래",
