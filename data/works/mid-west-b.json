[
  {
    "id": "zora-neale-hurston--jonahs-gourd-vine",
    "authorId": "zora-neale-hurston",
    "titleKo": "요나의 박넝쿨",
    "titleOriginal": "Jonah's Gourd Vine",
    "year": 1934,
    "genre": "fiction",
    "significance": "설교자 존 피어슨의 생애를 통해 흑인 교회의 설교를 소설의 문장 안으로 끌어들인 첫 장편. 채록한 구어와 설교의 리듬이 인물의 대사를 넘어 서술 자체로 번지기 시작한 지점이다.",
    "sourceIds": ["src--britannica", "src--library-of-america"]
  },
  {
    "id": "zora-neale-hurston--mules-and-men",
    "authorId": "zora-neale-hurston",
    "titleKo": "노새와 인간",
    "titleOriginal": "Mules and Men",
    "year": 1935,
    "genre": "essay-criticism",
    "significance": "플로리다 벌목 캠프와 뉴올리언스의 후두 의례에서 채록한 흑인 민담과 주술을, 학술 보고가 아니라 채록자 자신이 등장하는 서사로 엮었다. 프란츠 보애스가 서문을 쓴 이 책은 민속지와 문학의 경계를 흐린 초기 사례다.",
    "sourceIds": ["src--hurston-mules-and-men-boas-preface", "src--library-of-america"]
  },
  {
    "id": "zora-neale-hurston--their-eyes-were-watching-god",
    "authorId": "zora-neale-hurston",
    "titleKo": "그들의 눈은 신을 보고 있었다",
    "titleOriginal": "Their Eyes Were Watching God",
    "year": 1937,
    "genre": "fiction",
    "significance": "세 번의 결혼을 지나며 자기 목소리를 얻는 재니의 이야기를, 표준영어 서술과 흑인 남부 구어를 한 문장 안에 섞는 자유간접화법으로 썼다. 아이티 체류 중 몇 주 만에 쓴 이 소설은 1970년대 재발견 이후 미국 소설의 정전에 진입했다.",
    "sourceIds": ["src--britannica", "src--library-of-america", "src--kr-world-lit-editions"]
  },
  {
    "id": "zora-neale-hurston--tell-my-horse",
    "authorId": "zora-neale-hurston",
    "titleKo": "내 말에게 전해라",
    "titleOriginal": "Tell My Horse",
    "year": 1938,
    "genre": "essay-criticism",
    "significance": "자메이카와 아이티에서 수행한 현지조사 기록으로, 부두 의례와 빙의 사례를 두 나라의 정치사와 나란히 서술한다. 카리브를 미국 남부 흑인 문화의 연장선에서 본 시각이 이후 흑인 대서양 연구의 선례로 인용된다.",
    "sourceIds": ["src--library-of-america"]
  },
  {
    "id": "zora-neale-hurston--moses-man-of-the-mountain",
    "authorId": "zora-neale-hurston",
    "titleKo": "산의 사람 모세",
    "titleOriginal": "Moses, Man of the Mountain",
    "year": 1939,
    "genre": "fiction",
    "significance": "출애굽기의 모세를 후두 주술사로 다시 쓴 장편. 성서의 해방 서사를 미국 노예제의 경험 위에 겹치고 인물의 말을 남부 구어로 옮겨, 채록한 민간 신앙과 정전 텍스트를 같은 평면에 놓았다.",
    "sourceIds": ["src--library-of-america"]
  },
  {
    "id": "zora-neale-hurston--barracoon",
    "authorId": "zora-neale-hurston",
    "titleKo": "바라쿤",
    "titleOriginal": "Barracoon: The Story of the Last \"Black Cargo\"",
    "year": 2018,
    "genre": "essay-criticism",
    "significance": "대서양 노예무역으로 끌려온 마지막 생존자 가운데 한 사람으로 알려진 쿠조 루이스를 1920년대 후반에 인터뷰해 1931년 원고를 완성했으나, 구술을 표준영어로 고치라는 출판사 요구를 거부해 묻혔다가 2018년에야 출간되었다. 증언을 화자의 발음 그대로 남기려 한 원칙이 출판 자체를 막은 사례다.",
    "sourceIds": ["src--britannica"]
  },
  {
    "id": "ralph-ellison--invisible-man",
    "authorId": "ralph-ellison",
    "titleKo": "보이지 않는 인간",
    "titleOriginal": "Invisible Man",
    "year": 1952,
    "genre": "fiction",
    "significance": "이름 없는 화자가 남부 흑인대학에서 할렘의 정치조직까지 통과하며, 자신이 타인에게 보이지 않는 존재로 취급된다는 사실을 서술 형식 자체로 구현한 장편. 이듬해 전미도서상을 받으며 전후 미국 소설의 기준점이 되었다.",
    "sourceIds": ["src--britannica", "src--cambridge-companions", "src--kr-world-lit-editions"]
  },
  {
    "id": "ralph-ellison--shadow-and-act",
    "authorId": "ralph-ellison",
    "titleKo": "그림자와 행위",
    "titleOriginal": "Shadow and Act",
    "year": 1964,
    "genre": "essay-criticism",
    "significance": "재즈와 블루스, 미국 민속, 자신의 문학 수업을 다룬 평문 모음. 흑인 작가를 사회학적 증언자로 한정하는 비평에 대한 반론인 「세계와 항아리」가 여기에 실려 있다.",
    "sourceIds": ["src--ellison-world-and-the-jug"]
  },
  {
    "id": "ralph-ellison--going-to-the-territory",
    "authorId": "ralph-ellison",
    "titleKo": "영토를 향하여",
    "titleOriginal": "Going to the Territory",
    "year": 1986,
    "genre": "essay-criticism",
    "significance": "20여 년 만에 낸 두 번째 평문집. 미국 문화가 흑과 백의 상호 침투로 만들어졌다는 그의 논지를 음악·언어·지역사의 구체적 사례로 확장한다.",
    "sourceIds": ["src--britannica"]
  },
  {
    "id": "ralph-ellison--juneteenth",
    "authorId": "ralph-ellison",
    "titleKo": "준틴스",
    "titleOriginal": "Juneteenth",
    "year": 1999,
    "genre": "fiction",
    "significance": "40년 넘게 쓰다 미완으로 남긴 두 번째 장편의 원고를 유고 관리자 존 캘러핸이 한 권으로 편집해 사후 출간한 판본. 인종을 바꿔 살아온 상원의원과 흑인 목사의 관계를 다루며, 편집본이라는 지위 자체가 논쟁의 대상이 되었다.",
    "sourceIds": ["src--britannica"]
  },
  {
    "id": "james-baldwin--go-tell-it-on-the-mountain",
    "authorId": "james-baldwin",
    "titleKo": "산에 올라 고하라",
    "titleOriginal": "Go Tell It on the Mountain",
    "year": 1953,
    "genre": "fiction",
    "significance": "할렘의 오순절 교회에서 보낸 하룻밤을 축으로 삼아 한 가족 삼대의 회심과 죄의식을 되짚는 첫 장편. 흠정역 성서와 설교의 문장 리듬을 소설 산문으로 옮긴 볼드윈 문체의 출발점이다.",
    "sourceIds": ["src--britannica", "src--library-of-america", "src--kr-world-lit-editions"]
  },
  {
    "id": "james-baldwin--notes-of-a-native-son",
    "authorId": "james-baldwin",
    "titleKo": "미국의 아들의 기록",
    "titleOriginal": "Notes of a Native Son",
    "year": 1955,
    "genre": "essay-criticism",
    "significance": "아버지의 장례와 할렘 폭동이 겹친 하루를 다룬 표제 에세이를 포함한 첫 평문집. 리처드 라이트의 『미국의 아들』을 제목에서 되받으며, 항의소설이 흑인을 통계적 피해자로 축소한다는 비판을 산문의 실물로 제시했다.",
    "sourceIds": ["src--library-of-america", "src--baldwin-everybodys-protest-novel"]
  },
  {
