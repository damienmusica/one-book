[
  {
    "id": "bruno-schulz--sklepy-cynamonowe",
    "authorId": "bruno-schulz",
    "titleKo": "계피색 가게들",
    "titleOriginal": "Sklepy cynamonowe",
    "year": 1934,
    "genre": "fiction",
    "significance": "아버지의 상점과 드로호비치의 계절을 신화적 시간으로 재편한 첫 단편집으로, 조피아 나우코프스카의 추천으로 출간되며 무명 미술교사였던 저자를 폴란드 문단에 들여놓았다. 1933년 말에 인쇄되었으나 판권장 연도는 1934년이다.",
    "sourceIds": ["src--britannica", "src--culture-pl"]
  },
  {
    "id": "bruno-schulz--mityzacja-rzeczywistosci",
    "authorId": "bruno-schulz",
    "titleKo": "현실의 신화화",
    "titleOriginal": "Mityzacja rzeczywistości",
    "year": 1936,
    "genre": "essay-criticism",
    "significance": "낱말은 본래 신화의 파편이며 시는 그 파편을 다시 잇는 일이라고 주장한 짧은 강령. 자기 산문이 무엇을 하려는지 저자가 직접 밝힌 가장 압축된 글이다.",
    "sourceIds": ["src--culture-pl", "src--schulz-witkiewicz-1935"]
  },
  {
    "id": "bruno-schulz--sanatorium-pod-klepsydra",
    "authorId": "bruno-schulz",
    "titleKo": "모래시계 요양원",
    "titleOriginal": "Sanatorium pod Klepsydrą",
    "year": 1937,
    "genre": "fiction",
    "significance": "죽은 아버지가 시간을 되돌린 요양원에서 다시 살아 있는 표제작을 포함해, 첫 단편집의 세계를 시간 실험 쪽으로 확장한 두 번째이자 마지막 단편집이다.",
    "sourceIds": ["src--britannica", "src--culture-pl"]
  },
  {
    "id": "bruno-schulz--kometa",
    "authorId": "bruno-schulz",
    "titleKo": "혜성",
    "titleOriginal": "Kometa",
    "year": 1938,
    "genre": "fiction",
    "significance": "지구를 향해 오던 혜성이 방향을 틀며 종말이 취소되는 이야기로, 생전에 활자화된 마지막 단편 가운데 하나다. 두 단편집에 묶이지 못한 채 잡지에만 실렸다.",
    "sourceIds": ["src--culture-pl"]
  },
  {
    "id": "witold-gombrowicz--ferdydurke",
    "authorId": "witold-gombrowicz",
    "titleKo": "페르디두르케",
    "titleOriginal": "Ferdydurke",
    "year": 1937,
    "genre": "fiction",
    "significance": "서른 살 작가가 교사에게 끌려가 다시 중학생이 되는 설정으로, 성숙이라는 사회적 형식이 어떻게 강제되는지를 희극적 플롯으로 증명한다. '미성숙'과 '얼굴'이라는 그의 핵심 어휘가 여기서 정립되었다.",
    "sourceIds": ["src--britannica", "src--culture-pl"]
  },
  {
    "id": "witold-gombrowicz--iwona-ksiezniczka-burgunda",
    "authorId": "witold-gombrowicz",
    "titleKo": "이보나, 부르군드의 공주",
    "titleOriginal": "Iwona, księżniczka Burgunda",
    "year": 1938,
    "genre": "drama",
    "significance": "말이 거의 없는 여자를 궁정에 들여놓는 것만으로 궁정 전체가 자기 형식에 걸려 무너지는 희곡. 침묵을 무대의 동력으로 삼는 이 구조는 전후 부조리극과 자주 비교된다.",
    "sourceIds": ["src--culture-pl"]
  },
  {
    "id": "witold-gombrowicz--trans-atlantyk",
    "authorId": "witold-gombrowicz",
    "titleKo": "트란스아틀란티크",
    "titleOriginal": "Trans-Atlantyk",
    "year": 1953,
    "genre": "fiction",
    "significance": "1939년 부에노스아이레스에 발이 묶인 폴란드인을 화자로 삼아, 조국에 대한 의무와 그로부터의 해방을 옛 폴란드 이야기체(gawęda)를 패러디한 문체로 서술한다. 망명 폴란드 사회와 정면으로 충돌한 작품이다.",
    "sourceIds": ["src--culture-pl", "src--gombrowicz-testament"]
  },
  {
    "id": "witold-gombrowicz--dziennik",
    "authorId": "witold-gombrowicz",
    "titleKo": "일기",
    "titleOriginal": "Dziennik",
    "year": 1953,
    "genre": "essay-criticism",
    "significance": "파리의 망명지 잡지 『쿨투라』에 연재를 시작해 세 권으로 묶인 일기로, 사적 기록이 아니라 폴란드성·가톨릭·문학적 권위를 상대로 공개적으로 벌인 논쟁의 형식을 취한다. 연재는 1953년에 시작되어 사망 직전까지 이어졌다.",
    "sourceIds": ["src--gombrowicz-dziennik", "src--culture-pl"]
  },
  {
    "id": "witold-gombrowicz--pornografia",
    "authorId": "witold-gombrowicz",
    "titleKo": "포르노그라피아",
    "titleOriginal": "Pornografia",
    "year": 1960,
    "genre": "fiction",
    "significance": "독일 점령기 폴란드 시골을 배경으로 두 중년 남자가 젊은 남녀를 서로에게 밀어붙이며 상황을 연출하는 소설. 젊음을 훔쳐보고 조작하려는 시선 자체를 서사의 엔진으로 삼는다.",
    "sourceIds": ["src--britannica", "src--culture-pl"]
  },
  {
    "id": "witold-gombrowicz--kosmos",
    "authorId": "witold-gombrowicz",
    "titleKo": "코스모스",
    "titleOriginal": "Kosmos",
    "year": 1965,
    "genre": "fiction",
    "significance": "목매달린 참새와 천장의 얼룩 같은 사소한 기호에서 화자가 강박적으로 의미의 연쇄를 만들어내는 소설로, 탐정소설의 형식을 해석 강박의 실험으로 뒤집는다. 1967년 국제문학상(Prix International)을 받았다.",
    "sourceIds": ["src--britannica", "src--gombrowicz-testament"]
  },
  {
    "id": "hermann-broch--die-schlafwandler",
    "authorId": "hermann-broch",
    "titleKo": "몽유병자들",
    "titleOriginal": "Die Schlafwandler",
    "year": 1931,
    "genre": "fiction",
    "significance": "1888·1903·1918년을 각각 낭만주의·무정부·즉물성의 문체로 쓴 3부작으로, 마지막 권에는 '가치의 붕괴'라는 논문 장을 서사 사이에 끼워 넣었다. 1931년에 앞의 두 권, 1932년에 마지막 권이 나왔다.",
    "sourceIds": ["src--britannica", "src--cambridge-companions"]
  },
  {
    "id": "hermann-broch--james-joyce-und-die-gegenwart",
    "authorId": "hermann-broch",
    "titleKo": "제임스 조이스와 현재",
    "titleOriginal": "James Joyce und die Gegenwart",
    "year": 1936,
    "genre": "essay-criticism",
    "significance": "『율리시스』를 시대의 총체성을 담으려는 인식의 형식으로 읽어낸 강연문으로, 자기 소설이 무엇을 하려는지 밝히는 이론적 자기 설명이기도 하다.",
    "sourceIds": ["src--cambridge-companions"]
  },
  {
    "id": "hermann-broch--der-tod-des-vergil",
    "authorId": "hermann-broch",
    "titleKo": "베르길리우스의 죽음",
    "titleOriginal": "Der Tod des Vergil",
    "year": 1945,
    "genre": "fiction",
    "significance": "『아이네이스』를 태우려는 베르길리우스의 마지막 열여덟 시간을 물·불·흙·공기의 네 부분으로 나누어 서술한 장편으로, 예술이 죽음과 정치 앞에서 정당한가를 묻는다. 망명지 미국에서 완성되어 독일어판과 영역판이 1945년에 함께 나왔다.",
    "sourceIds": ["src--britannica", "src--cambridge-companions"]
  },
  {
    "id": "hermann-broch--die-schuldlosen",
    "authorId": "hermann-broch",
    "titleKo": "죄 없는 사람들",
    "titleOriginal": "Die Schuldlosen",
    "year": 1950,
    "genre": "fiction",
    "significance": "1913·1923·1933년을 배경으로 한 열한 편의 이야기를 하나의 장편으로 엮어, 나치즘에 적극 가담하지 않은 사람들의 '죄 없음'이 어떻게 정치적 무관심의 다른 이름이 되는지를 보여준다.",
    "sourceIds": ["src--cambridge-companions"]
  },
  {
    "id": "elias-canetti--hochzeit",
    "authorId": "elias-canetti",
    "titleKo": "결혼식",
    "titleOriginal": "Hochzeit",
    "year": 1932,
    "genre": "drama",
    "significance": "무너지기 직전의 임대 건물에 모인 인물들이 저마다 소유욕을 떠들다 붕괴를 맞는 희곡. 인물을 각자의 고정된 말투, 곧 '음향 가면'으로만 구성하는 그의 방법이 여기서 처음 실행되었다.",
    "sourceIds": ["src--britannica"]
  },
  {
    "id": "elias-canetti--die-blendung",
    "authorId": "elias-canetti",
    "titleKo": "현혹",
    "titleOriginal": "Die Blendung",
    "year": 1935,
    "genre": "fiction",
    "significance": "장서 2만 5천 권과 함께 사는 중국학자가 가정부와의 결혼으로 세계와 충돌하다 서재와 함께 불타는 장편. 1930~31년에 쓰여 1935년에 나왔고, 그가 남긴 유일한 소설이다.",
    "sourceIds": ["src--britannica", "src--nobelprize"]
  },
  {
    "id": "elias-canetti--masse-und-macht",
    "authorId": "elias-canetti",
    "titleKo": "군중과 권력",
    "titleOriginal": "Masse und Macht",
    "year": 1960,
    "genre": "essay-criticism",
    "significance": "군중의 발생과 유형, 그리고 권력자를 '살아남은 자'로 규정하는 이론을 신화·의례·정치사의 사례로 구성한 연구. 1927년 빈 법원 방화 사건에서 겪은 군중 경험 이후 30여 년에 걸쳐 쓴 그의 중심 저작이다.",
    "sourceIds": ["src--britannica", "src--nobelprize"]
  },
  {
    "id": "elias-canetti--die-stimmen-von-marrakesch",
    "authorId": "elias-canetti",
    "titleKo": "마라케시의 목소리들",
    "titleOriginal": "Die Stimmen von Marrakesch",
    "year": 1968,
    "genre": "essay-criticism",
    "significance": "1954년 마라케시 체류의 기록으로, 알아듣지 못하는 언어를 소리로만 관찰하는 방식을 택해 여행기를 청각의 기록으로 바꾸었다.",
    "sourceIds": ["src--britannica"]
  },
  {
    "id": "elias-canetti--die-gerettete-zunge",
    "authorId": "elias-canetti",
    "titleKo": "구제된 혀",
    "titleOriginal": "Die gerettete Zunge",
    "year": 1977,
    "genre": "essay-criticism",
    "significance": "라디노어를 쓰던 루세의 유년에서 어머니가 강제한 독일어 습득까지를 다룬 자서전 3부작의 첫 권으로, 왜 그가 독일어로 쓰게 되었는지를 언어 획득의 장면들로 설명한다.",
    "sourceIds": ["src--britannica", "src--nobelprize"]
  },
  {
    "id": "cesar-vallejo--los-heraldos-negros",
    "authorId": "cesar-vallejo",
    "titleKo": "검은 전령들",
    "titleOriginal": "Los heraldos negros",
    "year": 1919,
    "genre": "poetry",
    "significance": "모데르니스모의 음악성을 물려받되 안데스 농촌의 가톨릭·가족·죄의식을 시의 소재로 끌어들인 첫 시집이다. 판권장에는 1918년으로 찍혔으나 실제 배포는 1919년에 이루어졌다.",
    "sourceIds": ["src--britannica", "src--poetry-foundation"]
  },
  {
    "id": "cesar-vallejo--trilce",
    "authorId": "cesar-vallejo",
    "titleKo": "트릴세",
    "titleOriginal": "Trilce",
    "year": 1922,
    "genre": "poetry",
    "significance": "77편의 시에서 철자와 통사를 의도적으로 파괴하고 숫자·공백·조어를 도입해, 수감과 상실의 경험을 표기의 층위에서 재현했다. 초판은 리마 교도소 인쇄소에서 찍혔다.",
    "sourceIds": ["src--vallejo-trilce-1922-lima", "src--poetry-foundation"]
  },
  {
    "id": "cesar-vallejo--el-tungsteno",
    "authorId": "cesar-vallejo",
    "titleKo": "텅스텐",
    "titleOriginal": "El tungsteno",
    "year": 1931,
    "genre": "fiction",
    "significance": "안데스 광산의 외국 자본과 원주민 노동을 다룬 장편으로, 시에서의 실험을 접고 프롤레타리아 소설의 문법을 택한 예외적 작품이다.",
    "sourceIds": ["src--britannica"]
  },
  {
    "id": "cesar-vallejo--poemas-humanos",
    "authorId": "cesar-vallejo",
    "titleKo": "인간적인 시편들",
    "titleOriginal": "Poemas humanos",
    "year": 1939,
    "genre": "poetry",
    "significance": "파리 망명기에 쌓인 시들을 사후에 미망인 조르제트 바예호가 묶어 1939년 파리에서 낸 시집이다. 굶주림·병·노동하는 신체의 어휘로 『트릴세』의 실험을 인간의 시간에 다시 붙였다.",
    "sourceIds": ["src--britannica", "src--poetry-foundation"]
  },
  {
    "id": "cesar-vallejo--espana-aparta-de-mi-este-caliz",
    "authorId": "cesar-vallejo",
    "titleKo": "스페인이여, 내게서 이 잔을 거두어다오",
    "titleOriginal": "España, aparta de mí este cáliz",
    "year": 1939,
    "genre": "poetry",
    "significance": "스페인 내전 중에 쓴 열다섯 편의 시로, 공화국 병사와 민중을 애도하면서도 구호가 아니라 신체와 기도의 언어를 유지한다. 저자가 죽은 이듬해인 1939년에 단행본으로 나왔다.",
    "sourceIds": ["src--poetry-foundation"]
  },
  {
    "id": "anna-akhmatova--vecher",
    "authorId": "anna-akhmatova",
    "titleKo": "저녁",
    "titleOriginal": "Вечер",
    "year": 1912,
    "genre": "poetry",
    "significance": "구체적인 사물과 몸짓 하나로 감정의 국면을 지정하는 짧은 서정시를 처음 묶은 시집으로, 아크메이즘 시학의 실물 사례가 되었다.",
    "sourceIds": ["src--britannica", "src--poetry-foundation"]
  },
  {
    "id": "anna-akhmatova--chetki",
    "authorId": "anna-akhmatova",
    "titleKo": "묵주",
    "titleOriginal": "Чётки",
    "year": 1914,
    "genre": "poetry",
    "significance": "혁명 전 페테르부르크에서 거듭 판을 찍으며 그를 당대의 대표 시인으로 만든 두 번째 시집. 짧은 연애시의 형식 안에서 서사의 생략을 극한까지 밀어붙였다.",
    "sourceIds": ["src--britannica", "src--poetry-foundation"]
  },
  {
    "id": "anna-akhmatova--belaya-staya",
    "authorId": "anna-akhmatova",
    "titleKo": "하얀 새떼",
    "titleOriginal": "Белая стая",
    "year": 1917,
    "genre": "poetry",
    "significance": "전쟁과 혁명의 문턱에서 나온 시집으로, 연애시의 어휘가 역사적 시간을 받아들이기 시작하는 전환이 여기서 시작된다.",
    "sourceIds": ["src--poetry-foundation"]
  },
  {
    "id": "anna-akhmatova--rekviem",
    "authorId": "anna-akhmatova",
    "titleKo": "레퀴엠",
    "titleOriginal": "Реквием",
    "year": 1963,
    "genre": "poetry",
    "significance": "1935~40년에 쓴 연작으로, 아들의 체포 이후 레닌그라드 감옥 앞에 선 여자들의 줄을 화자의 자리로 삼는다. 소련에서는 출판이 불가능해 낭독과 암기로만 전해지다 1963년 뮌헨에서 저자의 관여 없이 러시아어 초판이 나왔고, 소련 국내 발표는 1987년에야 이루어졌다.",
    "sourceIds": ["src--britannica", "src--chukovskaya-zapiski"]
  },
  {
    "id": "anna-akhmatova--beg-vremeni",
    "authorId": "anna-akhmatova",
    "titleKo": "시간의 질주",
    "titleOriginal": "Бег времени",
    "year": 1965,
    "genre": "poetry",
    "significance": "생전 마지막으로 소련에서 나온 시선집으로, 초기부터 만년까지의 시를 저자가 직접 배열했다. 검열 때문에 『레퀴엠』은 실리지 못했다.",
    "sourceIds": ["src--britannica"]
  },
  {
    "id": "marina-tsvetaeva--vecherniy-albom",
    "authorId": "marina-tsvetaeva",
    "titleKo": "저녁 앨범",
    "titleOriginal": "Вечерний альбом",
