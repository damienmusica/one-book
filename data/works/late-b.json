[
  {
    "id": "salman-rushdie--midnights-children",
    "authorId": "salman-rushdie",
    "titleKo": "한밤의 아이들",
    "titleOriginal": "Midnight's Children",
    "year": 1981,
    "genre": "fiction",
    "significance": "인도 독립의 자정에 태어난 아이들에게 초능력을 주고, 그 화자의 기억이 틀리고 새는 방식을 서술 원리로 삼아 국가의 역사와 개인사를 한 문장 안에 겹쳐 놓았다. 부커상 수상작이며 이후 영어권 탈식민 소설의 참조점이 되었다.",
    "sourceIds": ["src--britannica", "src--cambridge-companions"]
  },
  {
    "id": "salman-rushdie--shame",
    "authorId": "salman-rushdie",
    "titleKo": "수치",
    "titleOriginal": "Shame",
    "year": 1983,
    "genre": "fiction",
    "significance": "파키스탄을 모델로 삼되 이름을 바꾼 나라를 무대로, 권력자 가문의 명예와 수치가 폭력으로 전환되는 회로를 우화의 문법으로 서술한다. 『한밤의 아이들』의 인도 서사와 짝을 이루는 작품이다.",
    "sourceIds": ["src--britannica"]
  },
  {
    "id": "salman-rushdie--the-satanic-verses",
    "authorId": "salman-rushdie",
    "titleKo": "악마의 시",
    "titleOriginal": "The Satanic Verses",
    "year": 1988,
    "genre": "fiction",
    "significance": "런던으로 이주한 두 인도인 배우의 변신담과 꿈속 종교 서사를 교차시켜 이주·개종·정체성의 분열을 다룬다. 출간 직후 국제적 논란과 저자에 대한 살해 위협으로 이어졌고, 이후 수십 년간 표현의 자유 논의에서 반복적으로 언급되는 사건이 되었다.",
    "sourceIds": ["src--britannica", "src--cambridge-companions"]
  },
  {
    "id": "salman-rushdie--haroun-and-the-sea-of-stories",
