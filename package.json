{
  "name": "one-book",
  "version": "0.1.0",
  "private": true,
  "description": "하나의 책 — 모든 책을 품은 하나의 책. A single curated book of 20th-century world literature: 100 authors, 513 works, every link carrying its reason and its source. Static HTML only; no accounts, no database, no tracking.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "npm run validate:data && tsx scripts/generate-static-pages.ts",
    "serve": "node qa/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --pool=forks",
    "test:watch": "vitest",
    "validate:data": "tsx scripts/validate-data.ts",
    "report:coverage": "tsx scripts/coverage-report.ts",
    "qc:crosscheck-dates": "tsx scripts/crosscheck-dates.ts",
    "qc:backfill-qids": "tsx scripts/backfill-qids.ts",
    "editions:resolve": "tsx scripts/resolve-editions.ts",
    "verify:book": "node qa/verify-book.mjs",
    "release": "npm run typecheck && npm run test && npm run build && npm run verify:book"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "playwright": "^1.62.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
